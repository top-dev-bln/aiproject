graph TB
  subgraph Controllers
    AdminController
    AuthController
    PermissionController
    ResetPasswordController
    RoleController
    TokenController
    UserController
  end
  subgraph Services
    FileStorageServiceImpl
    PermissionLoaderImpl
    PermissionServiceImpl
    RoleService
    RoleServiceImpl
    UserAccountService
    UserAccountServiceImpl
    UserService
    UserServiceImpl
  end
  subgraph Data_Access
    PermissionRepository
    RefreshTokenRepository
    RoleRepository
    UserAccountRepository
    UserRepository
  end
  subgraph Security
    AuthEntryPoint
    AuthenticationFilter
    CORSFilter
    OnResetPasswordEvent
    Permission
    PermissionLoadMode
    PermissionLoader
    PermissionService
    RefreshToken
    ResetPasswordListener
