    JwtUserDetailsServiceImpl
    StatisticService
    StatisticServiceImpl
    TravelService
    TravelServiceImpl
    UserAccountService
    UserAccountServiceImpl
    UserService
    UserServiceImpl
  end
  subgraph Data_Access
    Account
    AccountRepository
    Statistic
    StatisticRepository
    Travel
    TravelRepository
    User
    UserAccount
    UserAccountRepository
    UserRepository
