graph TB
  subgraph Controllers
    AccountController
    AuthenticationController
    StatisticController
    TravelController
    UserAccountController
    UserController
  end
  subgraph Services
    APIUsagePlansService
    APIUsagePlansServiceImpl
    AccountService
