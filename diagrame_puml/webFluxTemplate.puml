package com.transempiric.webfluxTemplate.config.security {
  class UnauthorizedAuthenticationEntryPoint {
    -exchange : ServerWebExchange
    -e : AuthenticationException
    +commence() : Mono<Void>
  }
  class JwtAuthenticationWebFilter {
    -authenticationManager : ReactiveAuthenticationManager
    -converter : JwtAuthenticationConverter
    -entryPoint : UnauthorizedAuthenticationEntryPoint
    -exchange : ServerWebExchange
    +matches() : Mono<MatchResult>
  }
  class JwtTokenUtil {
    -serialVersionUID : long
    -CLAIM_KEY_USERNAME : String
    -CLAIM_KEY_AUDIENCE : String
    -CLAIM_KEY_CREATED : String
    -AUDIENCE_UNKNOWN : String
    -AUDIENCE_WEB : String
    -AUDIENCE_MOBILE : String
    -AUDIENCE_TABLET : String
    -clock : Clock
    -secret : String
    +getUsernameFromToken() : String
    +getIssuedAtDateFromToken() : Date
    +getExpirationDateFromToken() : Date
    +getAudienceFromToken() : String
    +generateToken() : String
    +canTokenBeRefreshed() : Boolean
    +refreshToken() : String
    +validateToken() : Boolean
  }
  class JwtAuthenticationRequest {
    -serialVersionUID : long
    -username : String
    -password : String
    +getUsername() : String
    +setUsername() : void
    +getPassword() : String
    +setPassword() : void
  }
  class CustomReactiveAuthenticationManager {
    -logger : Logger
    -userDetailsService : ReactiveUserDetailsService
    -jwtTokenUtil : JwtTokenUtil
    -passwordEncoder : PasswordEncoder
    -authentication : Authentication
    -jwtPreAuthenticationToken : JwtPreAuthenticationToken
    -token : String
    +authenticate() : Mono<Authentication>
    +setPasswordEncoder() : void
  }
  class JwtAuthenticationConverter {
    -logger : Logger
    -userDetailsService : ReactiveUserDetailsService
    -jwtTokenUtil : JwtTokenUtil
    -tokenHeader : String
    -tokenParam : String
    -bearerPrefix : String
    +apply() : Mono<Authentication>
  }
  class CustomPasswordEncoder {
    +encode() : String
    +matches() : boolean
  }
  class JwtAuthenticationToken {
    -token : String
    +getToken() : String
    +getCredentials() : Object
  }
  class SecurityConfiguration {
    -AUTH_WHITELIST : String[]
    -http : ServerHttpSecurity
    -authenticationWebFilter : JwtAuthenticationWebFilter
    -entryPoint : UnauthorizedAuthenticationEntryPoint
    +springSecurityFilterChain() : SecurityWebFilterChain
    +securityContextRepository() : WebSessionServerSecurityContextRepository
    +encoder() : PasswordEncoder
    +jwtTokenUtil() : JwtTokenUtil
  }
  class JwtAuthenticationResponse {
    -serialVersionUID : long
    -token : String
    -username : String
    +getToken() : String
    +setToken() : void
    +getUsername() : String
    +setUsername() : void
  }
  class JwtPreAuthenticationToken {
    -authToken : String
    -bearerRequestHeader : String
    -username : String
    -authToken : String
    -bearerRequestHeader : String
    -username : String
    +getCredentials() : Object
    +getPrincipal() : Object
    +implies() : boolean
    +getAuthToken() : String
    +getBearerRequestHeader() : String
    +getUsername() : String
  }
}

