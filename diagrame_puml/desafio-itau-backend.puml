@startuml

package br.com.feltex.desafioitau {
  class DesafioItauApplicationTests {
  }
  class DesafioItauApplication {
    +main() : void
  }
}

package br.com.feltex.desafioitau.estatistica {
  class EstatisticaDTO {
    -count : long
    -sum : Double
    -avg : Double
    -min : Double
    -max : Double
    -doubleSummaryStatistics : DoubleSummaryStatistics
  }
  class EstatisticaController <<Controller>> {
    -intervaloMaximoEmSegundos : Integer
    -transacaoRepository : TransacaoRepository
    -horaInicial : var
    +estatistica() : ResponseEntity
  }
}

package br.com.feltex.desafioitau.transacao {
  class TransacaoRequest {
    -valor : BigDecimal
    -dataHora : OffsetDateTime
  }
  class TransacaoRepository <<Repository>> {
    -transacoes : List<TransacaoRequest>
    -valoresFiltrados : BigDecimal[]
    +add() : void
    +limpar() : void
    +estatistica() : EstatisticaDTO
  }
}

' --- Relatii ---
EstatisticaController --> TransacaoRepository
TransacaoRepository --> EstatisticaDTO

@enduml