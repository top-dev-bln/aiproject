@startuml

package cn.ssd.wean2016.springsecurity {
  class SpringsecurityApplicationTests {
    -userMapper : UserMapper
    +testGetUser() : void
  }
  class SpringsecurityApplication {
    +main() : void
  }
}

package cn.ssd.wean2016.springsecurity.config {
  class WebSecurityConfig {
    -unauthorizedHandler : EntryPointUnauthorizedHandler
    -accessDeniedHandler : MyAccessDeniedHandler
    +authenticationTokenFilterBean() : AuthenticationTokenFilter
    +configure() : void
  }
  class EntryPointUnauthorizedHandler {
    +commence() : void
  }
  class MyAccessDeniedHandler {
    +handle() : void
  }
}

package cn.ssd.wean2016.springsecurity.controller {
  class LoginController <<Controller>> {
    -loginService : LoginService
    -tokenHeader : String
    +login() : ResultMap
  }
}

package cn.ssd.wean2016.springsecurity.dao {
  interface UserMapper {
  }
}

package cn.ssd.wean2016.springsecurity.filter {
  class AuthenticationTokenFilter {
    -tokenHeader : String
    -tokenUtils : TokenUtils
    -userDetailsService : UserDetailsService
    +doFilter() : void
  }
}

package cn.ssd.wean2016.springsecurity.model {
  class SecurityModelFactory {
    +create() : UserDetailImpl
  }
  interface TokenDetail {
  }
  class ResultMap {
    +success() : ResultMap
    +fail() : ResultMap
    +message() : ResultMap
    +data() : ResultMap
    +token() : ResultMap
  }
  class TokenDetailImpl {
    -username : String
    +getUsername() : String
  }
  class UserDetailImpl {
    -id : String
    -username : String
    -password : String
    -lastPasswordReset : Date
    -enabled : Boolean
    -accountNonExpired : Boolean
    -accountNonLocked : Boolean
    -credentialsNonExpired : Boolean
    +getId() : String
    +setId() : void
    +getUsername() : String
    +setUsername() : void
    +getPassword() : String
    +setPassword() : void
    +getLastPasswordReset() : Date
    +setLastPasswordReset() : void
  }
  interface LoginDetail {
  }
}

package cn.ssd.wean2016.springsecurity.model.domain {
  class User {
    -username : String
    -password : String
    -authorities : String
    -lastPasswordChange : Long
    -enable : char
    +setUsername() : User
    +setPassword() : User
    +getAuthorities() : String
    +setAuthorities() : User
    +getLastPasswordChange() : Long
    +setLastPasswordChange() : User
    +setEnable() : User
    +getUsername() : String
  }
}

package cn.ssd.wean2016.springsecurity.model.vo {
  class RequestLoginUser {
    -username : String
    -password : String
    +getUsername() : String
    +setUsername() : RequestLoginUser
    +getPassword() : String
    +setPassword() : RequestLoginUser
  }
  class Data {
    +addObj() : Data
    +addChat() : Data
    +addAmount() : Data
    +addOutTradeNo() : Data
    +addActualProfit() : Data
    +addTradeStatus() : Data
    +addPresentGiftUuid() : Data
  }
}

package cn.ssd.wean2016.springsecurity.service {
  interface LoginService {
  }
}

package cn.ssd.wean2016.springsecurity.service.impl {
  class LoginServiceImpl <<Service>> {
    -userMapper : UserMapper
    -tokenUtils : TokenUtils
    +getLoginDetail() : LoginDetail
    +generateToken() : String
  }
  class UserDetailsServiceImpl <<Service>> {
    -userMapper : UserMapper
    +loadUserByUsername() : UserDetails
  }
}

package cn.ssd.wean2016.springsecurity.utils {
  class TokenUtils {
    -logger : Logger
    -secret : String
    -expiration : Long
    -claims : Claims
    -username : String
    -created : Date
    -claims : Claims
    -claims : Claims
    -expiration : Date
    +generateToken() : String
    +getUsernameFromToken() : String
    +validateToken() : Boolean
    +getCreatedDateFromToken() : Date
    +getExpirationDateFromToken() : Date
  }
}

' --- Relatii ---
SpringsecurityApplicationTests --> UserMapper
SpringsecurityApplicationTests --> User
WebSecurityConfig --> AuthenticationTokenFilter
UserMapper --> User
TokenUtils --> TokenDetail
TokenUtils --> UserDetailImpl
LoginController --> LoginDetail
LoginController --> ResultMap
LoginController --> TokenDetail
LoginController --> Data
LoginController --> RequestLoginUser
LoginController --> LoginService
LoginController --> TokenUtils
SecurityModelFactory --> User
TokenDetailImpl ..|> TokenDetail
User ..|> LoginDetail
User ..|> TokenDetail
User --> LoginDetail
User --> TokenDetail
AuthenticationTokenFilter --> TokenUtils
LoginService --> LoginDetail
LoginService --> TokenDetail
LoginServiceImpl ..|> LoginService
LoginServiceImpl --> UserMapper
LoginServiceImpl --> LoginDetail
LoginServiceImpl --> TokenDetail
LoginServiceImpl --> LoginService
LoginServiceImpl --> TokenUtils
UserDetailsServiceImpl --> UserMapper
UserDetailsServiceImpl --> SecurityModelFactory
UserDetailsServiceImpl --> User

@enduml