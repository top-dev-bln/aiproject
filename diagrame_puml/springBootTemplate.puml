@startuml

package com.linkinstars.springBootTemplate {
  class SpringBootTemplateApplicationTests {
    +contextLoads() : void
  }
  class SpringBootTemplateApplication {
    +main() : void
  }
}

package com.linkinstars.springBootTemplate.aop {
  class DemoAop {
    +before() : void
  }
  class GlobalExceptionResolver {
    +exceptionHandler() : ModelAndView
  }
}

package com.linkinstars.springBootTemplate.bean {
  class UserVO {
    -serialVersionUID : long
    -id : int
    -val : String
    +getId() : int
    +setId() : void
    +getVal() : String
    +setVal() : void
  }
  class UserEntity {
    -id : int
    -val : String
    +getId() : int
    +setId() : void
    +getVal() : String
    +setVal() : void
  }
}

package com.linkinstars.springBootTemplate.config {
  class DemoConfigTest {
    -demoConfig : DemoConfig
    +getDemoConfig() : void
  }
  class DruidConfig {
    +spyDataSource() : DataSource
    +druidDataSource() : DataSource
    +druidStartViewServlet() : ServletRegistrationBean
    +druidStartFilter() : FilterRegistrationBean
  }
  class TimeTaskConfig {
    +configureTasks() : void
  }
  class PackageConfig {
    -builder : SpringApplicationBuilder
    +configure() : SpringApplicationBuilder
  }
  class RedisConfig {
  }
  class TransactionConfig {
    -dataSource : DataSource
    +annotationDrivenTransactionManager() : PlatformTransactionManager
  }
  class MyBatisScannerConfig {
    +mapperScannerConfigurer() : MapperScannerConfigurer
  }
  class MyBatisConfig {
    -dataSource : DataSource
    +sqlSessionFactory() : SqlSessionFactoryBean
    +sqlSessionTemplate() : SqlSessionTemplate
  }
  class DemoConfig {
    -id : int
    -val : String
    +getId() : int
    +setId() : void
    +getVal() : String
    +setVal() : void
  }
}

package com.linkinstars.springBootTemplate.controller {
  class UserCacheController <<Controller>> {
    -userCacheService : IUserCacheService
    +listUser() : String
    +addUser() : String
    +deleteUser() : String
  }
  class UserController <<Controller>> {
    -userService : IUserService
    -redisUtil : RedisUtil
    +test() : String
    +upload() : String
  }
}

package com.linkinstars.springBootTemplate.dao {
  class UserDaoTest {
    -userDao : UserDao
    +listUser() : void
  }
  interface UserDao {
  }
}

package com.linkinstars.springBootTemplate.exception {
  class ServiceException {
  }
}

package com.linkinstars.springBootTemplate.service {
  interface IUserService {
  }
  interface IUserCacheService {
  }
}

package com.linkinstars.springBootTemplate.service.Impl {
  class UserCacheServiceImpl <<Service>> {
    +listUser() : List<UserVO>
    +addUser() : List<UserVO>
    +deleteUser() : boolean
  }
  class UserServiceImpl <<Service>> {
    -userDao : UserDao
    +listUser() : List<UserEntity>
    +addUser() : boolean
  }
}

package com.linkinstars.springBootTemplate.timer {
  class TimeTask {
    +test1() : void
  }
}

package com.linkinstars.springBootTemplate.util {
  class ProtostuffSerializer {
    -schema : Schema<ProtoWrapper>
    -wrapper : ProtoWrapper
    -buffer : LinkedBuffer
    -data : Object
    +serialize() : byte[]
    +deserialize() : T
  }
  class FileHandleUtil {
    -absolutePath : String
    -staticDir : String
    -fileDir : String
    +upload() : String
    +delete() : boolean
  }
  class CacheUserDb {
    -userVOList : List<UserVO>
  }
  class LogUtil {
    +printLog() : void
    +printLog() : void
  }
  class RedisUtil {
    -protoStuffTemplate : RedisTemplate
    +setExpireTime() : boolean
    +delete() : void
    +hasKey() : boolean
  }
  class KryoRedisSerializer {
    -logger : Logger
    -EMPTY_BYTE_ARRAY : byte[]
    -KRYOS : ThreadLocal<Kryo>
    -clazz : Class<T>
    +serialize() : byte[]
    +deserialize() : T
  }
}

package com.linkinstars.springBootTemplate.validator {
  class NotNullStringValidator {
    -fieldName : String
    +validate() : boolean
  }
}

' --- Relatii ---
UserDaoTest --> UserEntity
CacheUserDb --> UserVO
PackageConfig --> SpringBootTemplateApplication
RedisConfig --> ProtostuffSerializer
TimeTask --> LogUtil
UserDao --> UserEntity
DemoAop --> LogUtil
GlobalExceptionResolver --> ServiceException
GlobalExceptionResolver --> LogUtil
UserCacheController --> IUserCacheService
UserController --> UserEntity
UserController --> IUserService
UserController --> FileHandleUtil
UserController --> RedisUtil
UserController --> NotNullStringValidator
IUserService --> UserEntity
IUserCacheService --> UserVO
UserCacheServiceImpl ..|> IUserCacheService
UserCacheServiceImpl --> UserVO
UserCacheServiceImpl --> IUserCacheService
UserCacheServiceImpl --> CacheUserDb
UserServiceImpl ..|> IUserService
UserServiceImpl --> UserEntity
UserServiceImpl --> UserDao
UserServiceImpl --> IUserService

@enduml