@startuml

package code.landgrey {
  class Application {
    +main() : void
  }
}

package code.landgrey.bean {
  class User {
    -name : String
    -age : Integer
    -car : Car
    -secret : Object
    +setName() : void
    +getName() : String
    +setAge() : void
    +getAge() : Integer
