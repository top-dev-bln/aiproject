    -LAST_NAME : String
    -AGE : int
    -EMAIL : String
    -GENDER : String
    -BALANCE : BigDecimal
    -CITY : String
    +createTestUser() : User
  }
}

package com.syqu.shop.domain {
  class Product <<Entity>> {
    -id : long
    -name : String
    -category : Category
    -description : String
    -imageUrl : String
    -price : BigDecimal
  }
  class Category <<Entity>> {
    -id : long
    -categoryName : String
    -books : Set<Product>
  }
  class User <<Entity>> {
    -id : long
    -username : String
    -email : String
    -password : String
    -passwordConfirm : String
    -firstName : String
    -lastName : String
    -age : int
    -city : String
    -gender : String
  }
}

