package com.syqu.shop.creator {
  class ProductCreator {
    -NAME : String
    -DESCRIPTION : String
    -PRICE : BigDecimal
    -IMAGE_URL : String
    +createTestProduct() : Product
    +createTestProducts() : Set<Product>
  }
  class UserCreator {
    -USERNAME : String
