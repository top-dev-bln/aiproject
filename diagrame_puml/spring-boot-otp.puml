@startuml

package com.starter.springboot {
  class Application {
    +main() : void
  }
}

package com.starter.springboot.auth {
  class AuthenticationController <<Controller>> {
    -log : Logger
    -tokenProvider : TokenProvider
    -otpService : OtpService
    -authenticationManager : AuthenticationManager
    +authorize() : ResponseEntity<JWTToken>
    +verifyOtp() : ResponseEntity<JWTToken>
  }
}

package com.starter.springboot.config {
  class Http401UnauthorizedEntryPoint {
    -log : Logger
    +commence() : void
  }
  class SecurityConfiguration {
    -authenticationEntryPoint : Http401UnauthorizedEntryPoint
    -userDetailsService : UserDetailsService
    -tokenProvider : TokenProvider
    +passwordEncoder() : PasswordEncoder
    +configureGlobal() : void
    +configure() : void
    +securityEvaluationContextExtension() : SecurityEvaluationContextExtension
  }
  class EmailConfiguration {
    -providerConfiguration : ProviderConfiguration
    +mailSender() : JavaMailSender
  }
  class ProviderConfiguration {
    -host : String
    -port : Integer
    -username : String
    -password : String
    -debug : Boolean
    +getHost() : String
    +setHost() : void
    +getPort() : Integer
    +setPort() : void
    +getUsername() : String
    +setUsername() : void
    +getPassword() : String
    +setPassword() : void
  }
}

package com.starter.springboot.converters {
  class StringToDateConverter {
    +convertToDatabaseColumn() : Date
    +convertToEntityAttribute() : String
  }
  class LocalDateToUtilDateConverter {
    +convertToDatabaseColumn() : Date
    +convertToEntityAttribute() : LocalDate
  }
  class LocalDateToSqlDateConverter {
    +convertToDatabaseColumn() : Date
    +convertToEntityAttribute() : LocalDate
  }
}

package com.starter.springboot.domain {
  class User <<Entity>> {
    -id : Long
    -username : String
    -password : String
    -firstName : String
    -lastName : String
    -email : String
    -enabled : Boolean
    -lastPasswordResetDate : Date
    -isOtpRequired : Boolean
    -authorities : Set<Authority>
    +getId() : Long
    +setId() : void
    +getUsername() : String
    +setUsername() : void
    +getPassword() : String
    +setPassword() : void
    +getFirstName() : String
    +setFirstName() : void
  }
  class Authority <<Entity>> {
    -name : AuthorityName
    -users : List<User>
    +getName() : AuthorityName
    +setName() : void
    +getUsers() : List<User>
    +setUsers() : void
  }
  class Role <<Entity>> {
    -id : Long
    -name : String
    -description : String
    -users : Set<User>
    +getId() : Long
    +setId() : void
    +getName() : String
    +setName() : void
    +getDescription() : String
    +setDescription() : void
    +getUsers() : Set<User>
    +setUsers() : void
  }
}

package com.starter.springboot.enumeration {
  enum AuthorityName {
  }
}

package com.starter.springboot.exceptions {
  class UserNotActivatedException {
  }
}

package com.starter.springboot.repositories {
  interface UserRepository {
  }
}

package com.starter.springboot.rest.dto {
  class LoginDTO {
    -username : String
    -password : String
    -rememberMe : Boolean
    +getUsername() : String
    +setUsername() : void
    +getPassword() : String
    +setPassword() : void
    +isRememberMe() : Boolean
    +setRememberMe() : void
  }
  class VerifyTokenRequestDTO {
    -username : String
    -otp : Integer
    -rememberMe : Boolean
    +getUsername() : String
    +setUsername() : void
    +getOtp() : Integer
    +setOtp() : void
    +getRememberMe() : Boolean
    +setRememberMe() : void
  }
  class EmailDTO {
    -recipients : List<String>
    -ccList : List<String>
    -bccList : List<String>
    -subject : String
    -body : String
    -isHtml : Boolean
    -attachmentPath : String
    +getRecipients() : List<String>
    +setRecipients() : void
    +getCcList() : List<String>
    +setCcList() : void
    +getBccList() : List<String>
    +setBccList() : void
    +getSubject() : String
    +setSubject() : void
  }
}

package com.starter.springboot.rest.resources {
  class UserResource <<Controller>> {
    -log : Logger
    -userService : UserService
    +getUsers() : ResponseEntity<List<User>>
  }
}

package com.starter.springboot.security {
  class AuthoritiesConstants {
    -ADMIN : String
    -USER : String
    -ANONYMOUS : String
  }
  class SecurityUtils {
    +getCurrentUserLogin() : String
    +isAuthenticated() : boolean
    +isCurrentUserInRole() : boolean
  }
}

package com.starter.springboot.security.jwt {
  class JWTConfigurer {
    -AUTHORIZATION_HEADER : String
    -AUTHORIZATION_TOKEN : String
    -tokenProvider : TokenProvider
    +configure() : void
  }
  class JWTFilter {
    -log : Logger
    -tokenProvider : TokenProvider
    +doFilter() : void
  }
  class TokenProvider {
    -log : Logger
    -AUTHORITIES_KEY : String
    -secretKey : String
    -tokenValidityInSeconds : long
    -tokenValidityInSecondsForRememberMe : long
    -otpService : OtpService
    -userRepository : UserRepository
    +createToken() : String
    +createTokenAfterVerifiedOtp() : String
    +getAuthentication() : Authentication
    +validateToken() : boolean
  }
  class JWTToken {
    -idToken : String
    +getIdToken() : String
    +setIdToken() : void
  }
}

package com.starter.springboot.services {
  class UserService <<Service>> {
    -userRepository : UserRepository
    +findAllUsers() : List<User>
    +findEmailByUsername() : String
  }
  class OtpGenerator <<Service>> {
    -EXPIRE_MIN : Integer
    +load() : Integer
    +generateOTP() : Integer
    +getOPTByKey() : Integer
    +clearOTPFromCache() : void
  }
  class OtpService <<Service>> {
    -LOGGER : Logger
    -otpGenerator : OtpGenerator
    -emailService : EmailService
    -userService : UserService
    +generateOtp() : Boolean
    +validateOTP() : Boolean
  }
  class EmailService <<Service>> {
    -LOGGER : Logger
    -emailSender : JavaMailSender
    +sendSimpleMessage() : Boolean
  }
}

package com.starter.springboot.utils {
  class JSR310DateTimeSerializer {
    -ISOFormatter : DateTimeFormatter
    -INSTANCE : JSR310DateTimeSerializer
    +serialize() : void
  }
  class JSR310DateConverters {
    -INSTANCE : LocalDateToDateConverter
    -INSTANCE : DateToLocalDateConverter
    -INSTANCE : ZonedDateTimeToDateConverter
    -INSTANCE : DateToZonedDateTimeConverter
    -INSTANCE : LocalDateTimeToDateConverter
    -INSTANCE : DateToLocalDateTimeConverter
    +convert() : Date
    +convert() : LocalDate
    +convert() : Date
    +convert() : ZonedDateTime
    +convert() : Date
    +convert() : LocalDateTime
  }
  class RunningState <<Controller>> {
    +rootPageCheck() : ResponseEntity<String>
  }
  class JSR310LocalDateDeserializer {
    -INSTANCE : JSR310LocalDateDeserializer
    -ISO_DATE_OPTIONAL_TIME : DateTimeFormatter
    +deserialize() : LocalDate
  }
  class JSR310PersistenceConverters {
    +convertToEntityAttribute() : LocalDate
    +convertToDatabaseColumn() : Date
    +convertToEntityAttribute() : ZonedDateTime
    +convertToDatabaseColumn() : Date
    +convertToEntityAttribute() : LocalDateTime
  }
}

