@startuml

package com.brahalla.Cerberus {
  class Application {
    +main() : void
  }
}

package com.brahalla.Cerberus.configuration {
  class CorsFilter {
    -tokenHeader : String
    +doFilter() : void
    +init() : void
    +destroy() : void
  }
  class WebSecurityConfiguration {
    -unauthorizedHandler : EntryPointUnauthorizedHandler
    -userDetailsService : UserDetailsService
    -securityService : SecurityService
    +configureAuthentication() : void
    +passwordEncoder() : PasswordEncoder
    +authenticationManagerBean() : AuthenticationManager
    +authenticationTokenFilterBean() : AuthenticationTokenFilter
    +securityService() : SecurityService
    +configure() : void
  }
}

package com.brahalla.Cerberus.controller.rest {
  class AuthenticationController <<Controller>> {
    -logger : Logger
    -tokenHeader : String
    -authenticationManager : AuthenticationManager
    -tokenUtils : TokenUtils
    -userDetailsService : UserDetailsService
  }
  class ProtectedController <<Controller>> {
  }
}

package com.brahalla.Cerberus.domain.base {
  class DomainBase {
  }
}

package com.brahalla.Cerberus.domain.entity {
  class User <<Entity>> {
    -serialVersionUID : long
    -id : Long
    -username : String
    -password : String
    -email : String
    -lastPasswordReset : Date
    -authorities : String
    +getId() : Long
    +setId() : void
    +getUsername() : String
    +setUsername() : void
    +getPassword() : String
    +setPassword() : void
    +getEmail() : String
    +setEmail() : void
  }
}

package com.brahalla.Cerberus.integration.config {
  class TestContext {
    +servletContainer() : EmbeddedServletContainerFactory
  }
}

package com.brahalla.Cerberus.integration.controller.rest {
  class AuthenticationControllerTest {
    -client : RestTemplate
    -authenticationRequest : AuthenticationRequest
    -authenticationToken : String
    -authenticationRoute : String
    -refreshRoute : String
    -tokenUtils : TokenUtils
    +setUp() : void
    +tearDown() : void
    +requestingAuthenticationWithNoCredentialsReturnsBadRequest() : void
    +requestingAuthenticationWithInvalidCredentialsReturnsUnauthorized() : void
    +requestingProtectedWithValidCredentialsReturnsExpected() : void
    +requestingAuthenticationRefreshWithNoAuthorizationTokenReturnsUnauthorized() : void
    +requestingAuthenticationRefreshWithUnauthorizedCredentialsReturnsBadRequest() : void
    +requestingAuthenticationRefreshTokenWithTokenCreatedBeforeLastPasswordResetReturnsBadRequest() : void
  }
  class ProtectedControllerTest {
    -client : RestTemplate
    -authenticationRequest : AuthenticationRequest
    -authenticationToken : String
    -authenticationRoute : String
    -protectedRoute : String
    +setUp() : void
    +tearDown() : void
    +requestingProtectedWithNoAuthorizationTokenReturnsUnauthorized() : void
    +requestingProtectedWithUnauthorizedCredentialsReturnsForbidden() : void
    +requestingProtectedWithValidCredentialsReturnsExpected() : void
  }
}

package com.brahalla.Cerberus.integration.suite {
  class IntegrationTestSuite {
  }
}

package com.brahalla.Cerberus.integration.util {
  class TestApiConfig {
    -HOSTNAME : String
    -SERVER_CONTEXT : String
    -PORT : Integer
    -USER_AUTHENTICATION_REQUEST : AuthenticationRequest
    -ADMIN_AUTHENTICATION_REQUEST : AuthenticationRequest
    -EXPIRED_AUTHENTICATION_REQUEST : AuthenticationRequest
    -INVALID_AUTHENTICATION_REQUEST : AuthenticationRequest
    +getAbsolutePath() : String
  }
  class RequestEntityBuilder {
    +buildRequestEntity() : HttpEntity<Object>
    +buildRequestEntityWithoutBody() : HttpEntity<Object>
    +buildRequestEntityWithoutAuthenticationToken() : HttpEntity<Object>
    +buildRequestEntityWithoutBodyOrAuthenticationToken() : HttpEntity<Object>
  }
}

package com.brahalla.Cerberus.model.base {
  class ModelBase {
  }
}

package com.brahalla.Cerberus.model.factory {
  class CerberusUserFactory {
    +create() : CerberusUser
  }
}

package com.brahalla.Cerberus.model.json.request {
  class AuthenticationRequest {
    -serialVersionUID : long
    -username : String
    -password : String
    +getUsername() : String
    +setUsername() : void
    +getPassword() : String
    +setPassword() : void
  }
}

package com.brahalla.Cerberus.model.json.response {
  class AuthenticationResponse {
    -serialVersionUID : long
    -token : String
    +getToken() : String
    +setToken() : void
  }
}

package com.brahalla.Cerberus.model.security {
  class CerberusUser {
    -id : Long
    -username : String
    -password : String
    -email : String
    -lastPasswordReset : Date
    -accountNonExpired : Boolean
    -accountNonLocked : Boolean
    -credentialsNonExpired : Boolean
    -enabled : Boolean
    +getId() : Long
    +setId() : void
    +getUsername() : String
    +setUsername() : void
    +getPassword() : String
    +setPassword() : void
    +getEmail() : String
    +setEmail() : void
  }
}

package com.brahalla.Cerberus.repository {
  interface UserRepository {
    +findByUsername() : User
  }
}

package com.brahalla.Cerberus.security {
  class EntryPointUnauthorizedHandler {
    +commence() : void
  }
  class AuthenticationTokenFilter {
    -tokenHeader : String
    -tokenUtils : TokenUtils
    -userDetailsService : UserDetailsService
    +doFilter() : void
  }
  class TokenUtils {
    -logger : Logger
    -AUDIENCE_UNKNOWN : String
    -AUDIENCE_WEB : String
    -AUDIENCE_MOBILE : String
    -AUDIENCE_TABLET : String
    -secret : String
    -expiration : Long
    -claims : Claims
    -claims : Claims
    -claims : Claims
    +getUsernameFromToken() : String
    +getCreatedDateFromToken() : Date
    +getExpirationDateFromToken() : Date
    +getAudienceFromToken() : String
    +generateToken() : String
    +canTokenBeRefreshed() : Boolean
    +refreshToken() : String
    +validateToken() : Boolean
  }
}

package com.brahalla.Cerberus.service {
  interface SecurityService {
    +hasProtectedAccess() : Boolean
  }
}

package com.brahalla.Cerberus.service.impl {
  class SecurityServiceImpl <<Service>> {
    +hasProtectedAccess() : Boolean
  }
  class UserDetailsServiceImpl <<Service>> {
    -userRepository : UserRepository
    +loadUserByUsername() : UserDetails
  }
}

