@startuml

package com.eureka.auth {
  class SpringEurekaAuthApp {
    +main() : void
  }
}

package com.eureka.auth.security {
  class SecurityCredentialsConfig {
    -userDetailsService : UserDetailsService
    -jwtConfig : JwtConfig
    +configure() : void
    +configure() : void
    +jwtConfig() : JwtConfig
    +passwordEncoder() : BCryptPasswordEncoder
  }
  class JwtUsernameAndPasswordAuthenticationFilter {
    -authManager : AuthenticationManager
    -jwtConfig : JwtConfig
    -username : String
    +attemptAuthentication() : Authentication
    +successfulAuthentication() : void
    +getUsername() : String
    +setUsername() : void
    +getPassword() : String
    +setPassword() : void
  }
  class UserDetailsServiceImpl <<Service>> {
    -encoder : BCryptPasswordEncoder
    -users : List<AppUser>
    -id : Integer
    -username : String
    -role : String
    +loadUserByUsername() : UserDetails
    +getId() : Integer
    +setId() : void
    +getUsername() : String
    +setUsername() : void
    +getPassword() : String
    +setPassword() : void
    +getRole() : String
  }
}

package com.eureka.auth.tests {
  class SpringEurekaServiceApplicationTests {
    +contextLoads() : void
  }
}

