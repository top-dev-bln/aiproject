  class JwtAuthenticationTokenFilter {
    -jwtTokenUtil : JwtTokenUtil
    -defaultUserDetailsService : DefaultUserDetailsService
    +doFilterInternal() : void
  }
  class CustomAuthenticationFilter {
    +attemptAuthentication() : Authentication
  }
}

