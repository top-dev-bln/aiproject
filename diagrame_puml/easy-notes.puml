    +findOneByName() : Tag
    +findCountByUserId() : long
    +findList() : List<Tag>
  }
  class NotesRepository <<Repository>> {
    -mongoTemplate : MongoTemplate
    +insert() : Notes
    +update() : void
    +remove() : void
    +removeAll() : void
    +findOne() : Notes
    +findCountByCategoryId() : long
    +findCountByUserId() : long
    +findList() : List<Notes>
  }
  class CategoryRepository <<Repository>> {
    -mongoTemplate : MongoTemplate
    +findOne() : Category
    +insert() : Category
    +updateOne() : void
    +remove() : void
    +find() : List<Category>
    +findCountByUserId() : long
  }
  class UserRepository <<Repository>> {
    -mongoTemplate : MongoTemplate
    +insertOne() : void
    +updateOne() : void
    +findUserByUserId() : User
    +findUserByOAuth2Client() : User
  }
}

package cn.zealon.notes.security.config {
  class WebSecurityConfig {
    -defaultUserDetailsService : DefaultUserDetailsService
    -authenticationEntryPointConfig : AuthenticationEntryPointConfig
    -jwtAuthenticationTokenFilter : JwtAuthenticationTokenFilter
    +configure() : void
    +configure() : void
    +passwordEncoder() : PasswordEncoder
    +authenticationManagerBean() : AuthenticationManager
  }
  class OAuth2ClientProperties {
    -clientId : String
    -clientName : String
    -clientNameCn : String
    -clientSecret : String
    -accessTokenUri : String
    -userAuthorizationUri : String
