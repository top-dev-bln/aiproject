    -authenticationManager : AuthenticationManager
    -defaultUserDetailsService : DefaultUserDetailsService
    +login() : Result
    +refreshToken() : String
    +getLoginUserBean() : LoginUserBean
  }
}

package cn.zealon.notes.security.service {
  class OAuth2Service <<Service>> {
    -auth2ClientService : OAuth2ClientService
    -defaultUserDetailsService : DefaultUserDetailsService
