    -passwordEncoder : PasswordEncoder
    +encode() : String
    +matches() : boolean
  }
  class AuthenticationEntryPointConfig {
    -objectMapper : ObjectMapper
    +commence() : void
  }
}

package cn.zealon.notes.security.controller {
  class OAuth2Controller <<Controller>> {
    -auth2Service : OAuth2Service
    +authorizedCallback() : Result
  }
  class JwtAuthController <<Controller>> {
    -jwtAuthService : JwtAuthService
    +login() : Result
    +refresh() : Result
  }
}

package cn.zealon.notes.security.domain {
  class AuthenticationBean {
    -username : String
    -password : String
  }
  class OAuth2AccountInfo {
    -accountId : String
    -name : String
    -avatarUrl : String
  }
  class OAuth2AccessToken {
    -accessToken : String
    -tokenType : String
    -scope : String
    -uid : String
  }
  class WeiboCodeResult {
    -access_token : String
    -expires_in : Long
    -remind_in : String
    -uid : String
  }
  class GithubCodeResult {
    -access_token : String
    -token_type : String
    -scope : String
  }
  class LoginUserBean {
    -serialVersionUID : long
    -user : UserInfo
    -loginIp : String
    -loginTime : LocalDateTime
    +getPassword() : String
    +getUsername() : String
