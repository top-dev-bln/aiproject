    +processWithAsyncAnnotation() : CompletableFuture<String>
    +processWithAsyncUtils() : CompletableFuture<String>
    +processWithChaining() : CompletableFuture<String>
    +processWithErrorHandling() : CompletableFuture<String>
  }
}

