package org.asaunin.socialnetwork.domain {
  class Message <<Entity>> {
    -id : Long
    -sender : Person
    -recipient : Person
    -body : String
    -posted : Date
  }
  class Person <<Entity>> {
    -id : Long
    -firstName : String
    -lastName : String
    -fullName : String
    -shortName : String
    -email : String
    -password : String
    -phone : String
    -birthDate : Date
    -gender : Gender
    +hasFriend() : boolean
    +addFriend() : void
    +removeFriend() : void
    +isFriendOf() : boolean
    +setFirstName() : void
    +setLastName() : void
    +builder() : PersonBuilder
    +getUsername() : String
  }
  enum Gender {
    -id : int
    +getId() : int
    +getGender() : Gender
  }
  class Role <<Entity>> {
    -ADMIN : Role
    -USER : Role
    -id : Long
    -name : String
    -description : String
    -users : Set<Person>
  }
}

package org.asaunin.socialnetwork.domain.jpa {
