@startuml

package com.example.easynotes {
  class EasyNotesApplicationTests {
    +contextLoads() : void
  }
  class EasyNotesApplication {
    +main() : void
  }
}

package com.example.easynotes.controller {
  class NoteController <<Controller>> {
    +getAllNotes() : List<Note>
    +createNote() : Note
    +getNoteById() : Note
    +updateNote() : Note
  }
  class IndexController <<Controller>> {
    +sayHello() : String
  }
}

package com.example.easynotes.exception {
  class ResourceNotFoundException {
    -resourceName : String
    -fieldName : String
    -fieldValue : Object
    +getResourceName() : String
    +getFieldName() : String
    +getFieldValue() : Object
  }
}

package com.example.easynotes.model {
  class Note <<Entity>> {
    -id : Long
    -title : String
    -content : String
    -createdAt : Date
    -updatedAt : Date
    +getId() : Long
    +setId() : void
    +getTitle() : String
    +setTitle() : void
    +getContent() : String
    +setContent() : void
    +getCreatedAt() : Date
    +setCreatedAt() : void
  }
}

package com.example.easynotes.repository {
  interface NoteRepository <<Repository>> {
  }
}

' --- Relatii ---
NoteRepository --> Note
NoteController --> ResourceNotFoundException
NoteController --> Note
NoteController --> NoteRepository

@enduml