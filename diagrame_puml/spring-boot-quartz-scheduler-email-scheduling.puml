@startuml

package com.example.quartzdemo {
  class QuartzDemoApplicationTests {
    +contextLoads() : void
  }
  class QuartzDemoApplication {
    +main() : void
  }
}

package com.example.quartzdemo.controller {
  class EmailJobSchedulerController <<Controller>> {
    -logger : Logger
    -scheduler : Scheduler
    +scheduleEmail() : ResponseEntity<ScheduleEmailResponse>
  }
}

package com.example.quartzdemo.job {
  class EmailJob {
    -logger : Logger
    -mailSender : JavaMailSender
    -mailProperties : MailProperties
    +executeInternal() : void
  }
}

package com.example.quartzdemo.payload {
  class ScheduleEmailRequest {
    -email : String
    -subject : String
    -body : String
    -dateTime : LocalDateTime
    -timeZone : ZoneId
    +getEmail() : String
    +setEmail() : void
    +getSubject() : String
    +setSubject() : void
    +getBody() : String
    +setBody() : void
    +getDateTime() : LocalDateTime
    +setDateTime() : void
  }
  class ScheduleEmailResponse {
    -success : boolean
    -jobId : String
    -jobGroup : String
    -message : String
    +isSuccess() : boolean
    +setSuccess() : void
    +getJobId() : String
    +setJobId() : void
    +getJobGroup() : String
    +setJobGroup() : void
    +getMessage() : String
    +setMessage() : void
  }
}

' --- Relatii ---
EmailJobSchedulerController --> EmailJob
EmailJobSchedulerController --> ScheduleEmailRequest
EmailJobSchedulerController --> ScheduleEmailResponse

@enduml