@startuml

package pl.piomin.services.account {
  class AccountService {
    +main() : void
  }
}

package pl.piomin.services.account.api {
  class AccountController <<Controller>> {
    +findAccount() : Account
  }
}

package pl.piomin.services.account.model {
  class Account {
    -id : Integer
    -customerId : Integer
    -number : String
    -amount : int
    +getId() : Integer
    +setId() : void
    +getCustomerId() : Integer
    +setCustomerId() : void
    +getNumber() : String
    +setNumber() : void
    +getAmount() : int
    +setAmount() : void
  }
}

package pl.piomin.services.auth {
  class SecurityConfig {
    -dataSource : DataSource
    +configure() : void
    +configure() : void
  }
  class OAuth2Config {
    -authenticationManager : AuthenticationManager
    -dataSource : DataSource
    +configure() : void
    +configure() : void
    +configure() : void
    +tokenStore() : JdbcTokenStore
  }
  class AuthServer <<Controller>> {
    +main() : void
    +user() : Principal
    +dataSource() : DataSource
  }
}

package pl.piomin.services.discovery {
  class DiscoveryServer {
    +main() : void
  }
}

package pl.piomin.services.gateway {
  class WebMvcConfig {
    +addViewControllers() : void
  }
  class SecurityConfig {
    -dataSource : DataSource
    +configure() : void
    +configure() : void
  }
  class GatewayServer {
    +main() : void
    +dataSource() : DataSource
  }
}

