    +druidStatProxy() : DefaultAdvisorAutoProxyCreator
    +druidWebStatFilter() : FilterRegistrationBean
  }
  class DruidDataSourceInitializerAutoConfiguration {
    +dataSourceInitializer() : DruidDataSourceInitializer
  }
  class DruidServletConfiguration {
    +druidStatViewServlet() : ServletRegistrationBean
  }
  interface DruidDataSourceCustomizer {
  }
}

package com.github.trang.druid.autoconfigure.datasource {
  class DruidDataSource2 {
    -serialVersionUID : long
  }
  class AbstractDruidDataSource2 {
    -serialVersionUID : long
    -dataSourceProperties : DataSourceProperties
    -druidProperties : DruidDataSourceProperties
