@startuml

package com.github.trang.druid.actuate {
  class DruidDataSourcePoolMetadata {
    +getActive() : Integer
    +getMax() : Integer
    +getMin() : Integer
    +getValidationQuery() : String
  }
  class DruidDataSourceMvcEndpoint {
    -statService : DruidStatService
    -timeout : long
    -lock : Lock
    +handle() : String
  }
  class DruidDataSourceEndpoint {
    -STAT_MANAGER : DruidStatManagerFacade
  }
}

package com.github.trang.druid.actuate.autoconfigure {
  class DruidDataSourceEndpointConfiguration {
    +druidDataSourceEndpoint() : DruidDataSourceEndpoint
    +druidDataSourceMvcEndpoint() : DruidDataSourceMvcEndpoint
  }
  class DruidDataSourceMetadataProviderConfiguration {
    +dataSourcePoolMetadataProvider() : DataSourcePoolMetadataProvider
  }
  class DruidDataSourceActuatorAutoConfiguration {
  }
}

package com.github.trang.druid.autoconfigure {
  class DruidDataSourceConfiguration {
    -BEAN_NAME : String
    -BEAN_SUFFIX : String
    -EMPTY : String
    -POINT : String
    -PREFIX : String
    -resolver : RelaxedPropertyResolver
    -environment : ConfigurableEnvironment
    -resolver : RelaxedPropertyResolver
    -customizers : List<DruidDataSourceCustomizer>
    -resolver : RelaxedPropertyResolver
    +registerBeanDefinitions() : void
    +setEnvironment() : void
    +registerBeanDefinitions() : void
    +setEnvironment() : void
    +setCustomizers() : void
    +postProcessBeforeInitialization() : Object
    +postProcessAfterInitialization() : Object
    +setEnvironment() : void
  }
  class DruidAutoConfiguration {
    +statFilter() : StatFilter
    +wallConfig() : WallConfig
    +wallFilter() : WallFilter
    +configFilter() : ConfigFilter
    +slf4jLogFilter() : Slf4jLogFilter
    +log4jFilter() : Log4jFilter
    +log4j2Filter() : Log4j2Filter
    +commonsLogFilter() : CommonsLogFilter
  }
  class DruidStatConfiguration {
    -proxyTargetClass : boolean
    +druidStatInterceptor() : DruidStatInterceptor
