@startuml

package com.websocket.chat {
  class WebsocketchatApplication {
    +main() : void
  }
}

package com.websocket.chat.config {
  class WebSecurityConfig {
    +configure() : void
    +configure() : void
  }
  class RedisConfig {
    +channelTopic() : ChannelTopic
    +redisMessageListener() : RedisMessageListenerContainer
    +listenerAdapter() : MessageListenerAdapter
  }
  class EmbeddedRedisConfig {
    -redisPort : int
    -redisServer : RedisServer
    +redisServer() : void
    +stopRedis() : void
  }
  class WebSockConfig {
    -stompHandler : StompHandler
    +configureMessageBroker() : void
    +registerStompEndpoints() : void
    +configureClientInboundChannel() : void
  }
}

package com.websocket.chat.config.handler {
  class StompHandler {
    -jwtTokenProvider : JwtTokenProvider
    -chatRoomRepository : ChatRoomRepository
    -chatService : ChatService
  }
}

package com.websocket.chat.controller {
  class ChatRoomController <<Controller>> {
    -chatRoomRepository : ChatRoomRepository
    -jwtTokenProvider : JwtTokenProvider
    +rooms() : String
    +room() : List<ChatRoom>
    +createRoom() : ChatRoom
    +roomDetail() : String
    +roomInfo() : ChatRoom
    +getUserInfo() : LoginInfo
  }
  class IndexController <<Controller>> {
    +index() : String
  }
  class ChatController <<Controller>> {
    -jwtTokenProvider : JwtTokenProvider
    -chatRoomRepository : ChatRoomRepository
    -chatService : ChatService
    +message() : void
  }
}

package com.websocket.chat.model {
  class ChatRoom {
    -serialVersionUID : long
    -roomId : String
    -name : String
    -userCount : long
    +create() : ChatRoom
  }
  class LoginInfo {
    -name : String
    -token : String
  }
  class ChatMessage {
    -type : MessageType
    -roomId : String
    -sender : String
    -message : String
    -userCount : long
  }
}

package com.websocket.chat.pubsub {
  class RedisSubscriber <<Service>> {
    -objectMapper : ObjectMapper
    -messagingTemplate : SimpMessageSendingOperations
    +sendMessage() : void
  }
}

package com.websocket.chat.repo {
  class ChatRoomRepository <<Service>> {
    -CHAT_ROOMS : String
    -USER_COUNT : String
    -ENTER_INFO : String
    +findAllRoom() : List<ChatRoom>
    +findRoomById() : ChatRoom
    +createChatRoom() : ChatRoom
    +setUserEnterInfo() : void
    +getUserEnterRoomId() : String
    +removeUserEnterInfo() : void
    +getUserCount() : long
    +plusUserCount() : long
  }
}

package com.websocket.chat.service {
  class JwtTokenProviderTest {
    -jwtTokenProvider : JwtTokenProvider
    +createAndValidToken() : void
    +createAndValidToken() : void
  }
  class ChatService <<Service>> {
    -channelTopic : ChannelTopic
    -redisTemplate : RedisTemplate
    -chatRoomRepository : ChatRoomRepository
    +getRoomId() : String
    +sendChatMessage() : void
  }
  class JwtTokenProvider {
    -secretKey : String
    -tokenValidMilisecond : long
    +generateToken() : String
    +getUserNameFromJwt() : String
    +validateToken() : boolean
  }
}

' --- Relatii ---
RedisConfig --> RedisSubscriber
WebSockConfig --> StompHandler
StompHandler --> ChatMessage
StompHandler --> ChatRoomRepository
StompHandler --> ChatService
StompHandler --> JwtTokenProvider
ChatRoomController --> ChatRoom
ChatRoomController --> LoginInfo
ChatRoomController --> ChatRoomRepository
ChatRoomController --> JwtTokenProvider
ChatController --> ChatMessage
ChatController --> ChatRoomRepository
ChatController --> ChatService
ChatController --> JwtTokenProvider
RedisSubscriber --> ChatMessage
ChatService --> ChatMessage
ChatService --> ChatRoomRepository
ChatRoomRepository --> ChatRoom

@enduml