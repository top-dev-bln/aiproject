UserService --> RegistrationRequest
UserService --> RegistrationResponse
UserServiceImpl ..|> UserService
UserServiceImpl --> User
UserServiceImpl --> UserRole
UserServiceImpl --> UserRepository
UserServiceImpl --> AuthenticatedUserDto
UserServiceImpl --> RegistrationRequest
UserServiceImpl --> RegistrationResponse
UserServiceImpl --> UserMapper
UserServiceImpl --> UserValidationService
UserServiceImpl --> GeneralMessageAccessor
UserDetailsServiceImpl --> UserRole
UserDetailsServiceImpl --> AuthenticatedUserDto
UserDetailsServiceImpl --> User
