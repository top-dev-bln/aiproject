VehicleRepositoryTest --> VehicleRepository
DataInitializer --> User
DataInitializer --> Vehicle
DataInitializer --> UserRepository
DataInitializer --> VehicleRepository
VehicleRepository --> Brand
VehicleRepository --> Vehicle
UserRepository --> User
SecurityConfig --> UserRepository
SecurityConfig --> JwtTokenAuthenticationFilter
SecurityConfig --> JwtTokenProvider
JwtTokenProvider --> User
