package org.zerhusen.security {
  class SecurityUtilsTest {
    +getCurrentUsername() : void
    +getCurrentUsernameForNoAuthenticationInContext() : void
  }
  class JwtAuthenticationEntryPoint {
    +commence() : void
  }
  class UserModelDetailsService {
    -log : Logger
    -userRepository : UserRepository
    -login : String
    +loadUserByUsername() : UserDetails
  }
  class JwtAccessDeniedHandler {
    +handle() : void
  }
  class SecurityUtils {
    -LOG : Logger
    -authentication : Authentication
    +getCurrentUsername() : Optional<String>
  }
  class UserNotActivatedException {
    -serialVersionUID : long
  }
}

package org.zerhusen.security.jwt {
  class JWTConfigurer {
    -tokenProvider : TokenProvider
    +configure() : void
  }
  class JWTFilter {
    -LOG : Logger
    -AUTHORIZATION_HEADER : String
    -tokenProvider : TokenProvider
    +doFilter() : void
  }
  class TokenProvider {
    -log : Logger
    -AUTHORITIES_KEY : String
    -base64Secret : String
    -tokenValidityInMilliseconds : long
    -tokenValidityInMillisecondsForRememberMe : long
    -key : Key
    +afterPropertiesSet() : void
    +createToken() : String
    +getAuthentication() : Authentication
    +validateToken() : boolean
  }
}

package org.zerhusen.security.model {
  class User <<Entity>> {
    -id : Long
    -username : String
    -password : String
    -firstname : String
    -lastname : String
    -email : String
    -activated : boolean
    -authorities : Set<Authority>
    +getId() : Long
    +setId() : void
    +getUsername() : String
    +setUsername() : void
    +getPassword() : String
    +setPassword() : void
    +getFirstname() : String
    +setFirstname() : void
  }
  class Authority <<Entity>> {
    -name : String
    +getName() : String
    +setName() : void
  }
}

package org.zerhusen.security.repository {
  interface AuthorityRepository {
  }
  interface UserRepository {
  }
}

package org.zerhusen.security.rest {
  class UserRestControllerTest {
    -token : String
    +setUp() : void
    +getActualUserForUserWithToken() : void
    +getActualUserForUserWithoutToken() : void
  }
  class AuthenticationRestControllerTest {
    +successfulAuthenticationWithUser() : void
    +successfulAuthenticationWithAdmin() : void
    +unsuccessfulAuthenticationWithDisabled() : void
    +unsuccessfulAuthenticationWithWrongPassword() : void
    +unsuccessfulAuthenticationWithNotExistingUser() : void
  }
  class UserRestController <<Controller>> {
