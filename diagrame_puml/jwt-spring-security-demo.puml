    +configure() : void
    +configure() : void
  }
  class CorsConfig {
    +corsFilter() : CorsFilter
  }
}

package org.zerhusen.rest {
  class PersonRestControllerTest {
    -token : String
    -token : String
    +getPersonForUser() : void
    +getPersonForAdmin() : void
    +getPersonForAnonymous() : void
  }
  class AdminProtectedRestControllerTest {
    -token : String
    -token : String
    +getAdminProtectedGreetingForUser() : void
    +getAdminProtectedGreetingForAdmin() : void
    +getAdminProtectedGreetingForAnonymous() : void
  }
  class PersonRestController <<Controller>> {
    -name : String
    -email : String
    +getPerson() : ResponseEntity<Person>
    +getName() : String
    +getEmail() : String
  }
  class AdminProtectedRestController <<Controller>> {
    -message : String
    +getAdminProtectedGreeting() : ResponseEntity<HiddenMessage>
