@startuml

package com.ard333.springbootwebfluxjjwt {
  class SpringBootWebfluxJjwtApplication {
    +main() : void
  }
}

package com.ard333.springbootwebfluxjjwt.model {
  class Message {
    -content : String
  }
  class User {
    -serialVersionUID : long
    -username : String
    -password : String
    -enabled : Boolean
    -roles : List<Role>
    +getUsername() : String
    +setUsername() : void
    +isAccountNonExpired() : boolean
    +isAccountNonLocked() : boolean
    +isCredentialsNonExpired() : boolean
    +isEnabled() : boolean
    +getPassword() : String
    +setPassword() : void
  }
}

package com.ard333.springbootwebfluxjjwt.model.security {
  class AuthResponse {
    -token : String
  }
  enum Role {
  }
  class AuthRequest {
    -username : String
    -password : String
  }
}

package com.ard333.springbootwebfluxjjwt.rest {
  class AuthenticationREST <<Controller>> {
    -jwtUtil : JWTUtil
    -passwordEncoder : PBKDF2Encoder
    -userService : UserService
    +login() : Mono<ResponseEntity<AuthResponse>>
  }
  class ResourceREST <<Controller>> {
    +user() : Mono<ResponseEntity<Message>>
    +admin() : Mono<ResponseEntity<Message>>
    +userOrAdmin() : Mono<ResponseEntity<Message>>
  }
}

package com.ard333.springbootwebfluxjjwt.security {
  class JWTUtil {
    -secret : String
    -expirationTime : String
    -key : Key
    -expiration : Date
    -createdDate : Date
    -expirationDate : Date
    +init() : void
    +getAllClaimsFromToken() : Claims
    +getUsernameFromToken() : String
    +getExpirationDateFromToken() : Date
    +generateToken() : String
    +validateToken() : Boolean
  }
  class WebSecurityConfig {
    -authenticationManager : AuthenticationManager
    -securityContextRepository : SecurityContextRepository
    +securitygWebFilterChain() : SecurityWebFilterChain
  }
  class SecurityContextRepository {
    -authenticationManager : AuthenticationManager
    +save() : Mono<Void>
    +load() : Mono<SecurityContext>
  }
  class AuthenticationManager {
    -jwtUtil : JWTUtil
    +authenticate() : Mono<Authentication>
  }
  class PBKDF2Encoder {
    -secret : String
    -iteration : Integer
    -keylength : Integer
    +encode() : String
    +matches() : boolean
  }
  class CORSFilter {
    +addCorsMappings() : void
  }
}

package com.ard333.springbootwebfluxjjwt.security.model {
  class AuthResponse {
    -token : String
  }
  enum Role {
  }
  class AuthRequest {
    -username : String
    -password : String
  }
}

package com.ard333.springbootwebfluxjjwt.service {
  class UserService <<Service>> {
    +init() : void
    +findByUsername() : Mono<User>
  }
}

package id.web.ard.springbootwebfluxjjwt {
  class DemoApplicationTests {
  }
}

' --- Relatii ---
JWTUtil --> User
User --> Role
UserService --> User
UserService --> Role
AuthenticationREST --> AuthRequest
AuthenticationREST --> AuthResponse
AuthenticationREST --> JWTUtil
AuthenticationREST --> PBKDF2Encoder
AuthenticationREST --> UserService
ResourceREST --> Message

@enduml