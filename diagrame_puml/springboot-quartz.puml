@startuml

package com.jverson.quartz {
  class AppTest {
    +suite() : Test
    +testApp() : void
  }
  class QuartzApplication {
    +main() : void
  }
}

package com.jverson.quartz.common {
  class Message {
    -serialVersionUID : long
    +failure() : Message
    +failure() : Message
    +failure() : Message
    +success() : Message
    +success() : Message
    +isValid() : boolean
    +setValid() : void
    +getMsg() : String
  }
}

package com.jverson.quartz.conf {
  class SchedulerConfig {
    +jobFactory() : JobFactory
    +schedulerFactoryBean() : Scheduler
    +quartzProperties() : Properties
  }
  class RabbitConfig {
    +queue() : Queue
    +sender() : Sender
    +receiver() : Receiver
  }
}

package com.jverson.quartz.controller {
  class IndexController <<Controller>> {
    -scheduleJobService : ScheduleJobService
    +index() : String
  }
  class RestfulController <<Controller>> {
    -logger : Logger
    -scheduleJobService : ScheduleJobService
    +metaData() : Object
    +getAllJobs() : Object
    +getRunningJobs() : Object
    +pauseJob() : Object
    +resumeJob() : Object
    +deleteJob() : Object
    +runJob() : Object
    +saveOrupdate() : Object
  }
}

package com.jverson.quartz.job {
  class QuartzJobFactory {
    -sampleService : SampleService
    -sender : Sender
    -jobList : List<ScheduleJob>
    +getInitAllJobs() : List<ScheduleJob>
    +execute() : void
  }
  class ScheduleJob {
    -serialVersionUID : long
    -jobId : String
    -jobName : String
    -jobGroup : String
    -jobStatus : String
    -cronExpression : String
    -desc : String
    -interfaceName : String
    +getJobId() : String
    +setJobId() : void
    +getJobName() : String
    +setJobName() : void
    +getJobGroup() : String
    +setJobGroup() : void
    +getJobStatus() : String
    +setJobStatus() : void
  }
}

package com.jverson.quartz.mq {
  class Receiver {
    -logger : Logger
    +process() : void
  }
  class Sender {
    -logger : Logger
    -amqpTemplate : AmqpTemplate
    +send() : void
  }
}

package com.jverson.quartz.service {
  class ScheduleJobService <<Service>> {
    -scheduler : Scheduler
    +getAllJobList() : List<ScheduleJob>
    +getRunningJobList() : List<ScheduleJob>
    +saveOrupdate() : void
    +pauseJob() : void
    +resumeJob() : void
    +deleteJob() : void
    +runJobOnce() : void
    +getMetaData() : SchedulerMetaData
  }
  class SampleService <<Service>> {
    -LOG : Logger
    +hello() : void
  }
}

package com.jverson.quartz.spring {
  class AutowiringSpringBeanJobFactory {
    -context : ApplicationContext
    -bundle : TriggerFiredBundle
    -job : Object
    +setApplicationContext() : void
    +createJobInstance() : Object
  }
}

' --- Relatii ---
IndexController --> ScheduleJob
IndexController --> ScheduleJobService
RestfulController --> Message
RestfulController --> ScheduleJob
RestfulController --> ScheduleJobService
QuartzJobFactory --> Sender
QuartzJobFactory --> SampleService
ScheduleJobService --> QuartzJobFactory
ScheduleJobService --> ScheduleJob
SchedulerConfig --> QuartzJobFactory
SchedulerConfig --> ScheduleJob
SchedulerConfig --> AutowiringSpringBeanJobFactory
RabbitConfig --> Sender

@enduml