JwtUtils --> User
JwtUtils --> UserDetailsImpl
AuthTokenFilter --> UserDetailsServiceImpl
RefreshTokenService --> TokenRefreshException
RefreshTokenService --> RefreshToken
RefreshTokenService --> RefreshTokenRepository
RefreshTokenService --> UserRepository
UserDetailsServiceImpl --> User
UserDetailsServiceImpl --> UserRepository
UserDetailsImpl --> User
TokenControllerAdvice --> TokenRefreshException
AuthController --> TokenRefreshException
AuthController --> ERole
AuthController --> RefreshToken
AuthController --> Role
AuthController --> User
AuthController --> LoginRequest
AuthController --> SignupRequest
AuthController --> UserInfoResponse
AuthController --> MessageResponse
AuthController --> RoleRepository
AuthController --> UserRepository
AuthController --> JwtUtils
AuthController --> RefreshTokenService
AuthController --> UserDetailsImpl

@enduml