package br.com.jorgeacetozi.ebookChat.chatroom.domain.service {
  class RedisChatRoomService <<Service>> {
    -webSocketMessagingTemplate : SimpMessagingTemplate
    -chatRoomRepository : ChatRoomRepository
    -instantMessageService : InstantMessageService
    +save() : ChatRoom
    +findById() : ChatRoom
    +join() : ChatRoom
    +leave() : ChatRoom
    +sendPublicMessage() : void
    +sendPrivateMessage() : void
    +findAll() : List<ChatRoom>
  }
  interface ChatRoomService {
  }
  class CassandraInstantMessageService <<Service>> {
    -instantMessageRepository : InstantMessageRepository
    -chatRoomService : ChatRoomService
    +appendInstantMessageToConversations() : void
    +findAllInstantMessagesFor() : List<InstantMessage>
  }
  interface InstantMessageService {
  }
}

