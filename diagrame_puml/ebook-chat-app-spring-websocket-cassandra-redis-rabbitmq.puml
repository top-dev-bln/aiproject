@startuml

package br.com.jorgeacetozi.ebookChat {
  class Application {
    +main() : void
  }
}

package br.com.jorgeacetozi.ebookChat.authentication.api {
  class AuthenticationController <<Controller>> {
    -userService : UserService
    -newUserValidator : NewUserValidator
    +initBinder() : void
    +login() : String
    +newAccount() : String
    +createAccount() : String
  }
}

package br.com.jorgeacetozi.ebookChat.authentication.domain.model {
  class User <<Entity>> {
    -username : String
    -password : String
    -name : String
    -email : String
    -roles : Set<Role>
    +getUsername() : String
    +setUsername() : void
    +getPassword() : String
    +setPassword() : void
    +getName() : String
    +setName() : void
    +getEmail() : String
    +setEmail() : void
  }
  class Role <<Entity>> {
    -id : Integer
    -name : String
    -prime : int
    +getId() : Integer
    +setId() : void
    +getName() : String
    +setName() : void
  }
}

package br.com.jorgeacetozi.ebookChat.authentication.domain.repository {
  interface RoleRepository {
  }
  interface UserRepository {
  }
}

package br.com.jorgeacetozi.ebookChat.authentication.domain.service {
  interface UserService {
  }
  class DefaultUserService <<Service>> {
    -userRepository : UserRepository
    -roleRepository : RoleRepository
    -bCryptPasswordEncoder : BCryptPasswordEncoder
    +createUser() : User
  }
  class UserDetailsServiceImpl <<Service>> {
    -userRepository : UserRepository
    +loadUserByUsername() : UserDetails
  }
}

package br.com.jorgeacetozi.ebookChat.authentication.domain.validator {
  class NewUserValidator {
    -userRepository : UserRepository
    +supports() : boolean
    +validate() : void
  }
}

package br.com.jorgeacetozi.ebookChat.chat.api {
  class ChatController <<Controller>> {
    -chatRoomService : ChatRoomService
    +getRooms() : ModelAndView
  }
}

package br.com.jorgeacetozi.ebookChat.chatroom.api {
  class ChatRoomController <<Controller>> {
    -chatRoomService : ChatRoomService
    -instantMessageService : InstantMessageService
    +createChatRoom() : ChatRoom
    +join() : ModelAndView
    +listChatRoomConnectedUsersOnSubscribe() : List<ChatRoomUser>
    +listOldMessagesFromUserOnSubscribe() : List<InstantMessage>
    +sendMessage() : void
  }
}

package br.com.jorgeacetozi.ebookChat.chatroom.domain.model {
  class InstantMessageBuilder {
    -instantMessage : InstantMessage
    -instantMessageChatRoom : InstantMessageChatRoom
    -instantMessageType : InstantMessageType
    -instantMessageText : InstantMessageText
    -instantMessageFromUser : InstantMessageFromUser
    -instantMessageToUser : InstantMessageToUser
    +newMessage() : InstantMessageChatRoom
    +withChatRoomId() : InstantMessageType
    +systemMessage() : InstantMessageText
    +publicMessage() : InstantMessageFromUser
    +privateMessage() : InstantMessageToUser
    +toUser() : InstantMessageFromUser
    +fromUser() : InstantMessageText
    +withText() : InstantMessage
  }
  class InstantMessage {
    -username : String
    -chatRoomId : String
    -date : Date
    -fromUser : String
    -toUser : String
    -text : String
    -prime : int
    +isPublic() : boolean
    +isFromAdmin() : boolean
    +getUsername() : String
    +setUsername() : void
    +getChatRoomId() : String
    +setChatRoomId() : void
    +getDate() : Date
    +setDate() : void
  }
  class ChatRoomUser {
    -username : String
    -joinedAt : Date
    -prime : int
    +getUsername() : String
    +setUsername() : void
    +getJoinedAt() : Date
    +compareTo() : int
  }
  class ChatRoom {
    -id : String
    -name : String
    -description : String
    -connectedUsers : List<ChatRoomUser>
    -prime : int
    +getId() : String
    +setId() : void
    +getName() : String
    +setName() : void
    +getDescription() : String
    +setDescription() : void
    +getConnectedUsers() : List<ChatRoomUser>
    +addUser() : void
  }
}

