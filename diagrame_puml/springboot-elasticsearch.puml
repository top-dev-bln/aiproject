@startuml

package com.elasticsearch {
  class App {
    -logger : Logger
    +main() : void
  }
}

package com.elasticsearch.Model {
  class Order {
    -id : long
    -storeId : int
    -storeName : String
    -categoryId : int
    -categoryCode : String
    -productCode : String
    -quantity : int
    -amount : double
    -payDate : Date
  }
  class Es {
    -index : String
    -type : String
  }
}

package com.elasticsearch.config {
  class ElasticSearchConfig {
    -logger : Logger
    -host : String
    -port : Integer
    -clusterName : String
    -transportClient : TransportClient
    +transportClient() : TransportClient
    +bulkProcessor() : BulkProcessor
    +beforeBulk() : void
    +afterBulk() : void
    +afterBulk() : void
  }
}

package com.elasticsearch.service {
  class BulkProcessorServiceTest {
    -order : Order
    +testInsertById() : void
    +testUpdateById() : void
    +testDeleteById() : void
  }
  class ElasticSearchServiceTest {
    -order : Order
    +setUp() : void
    +testInsertById() : void
    +testUpdateById() : void
    +testDeleteById() : void
  }
  class QueryServiceTest {
    +setUp() : void
    +testInsertById() : void
  }
  interface ElasticSearchService {
  }
  interface QueryService {
  }
  interface BulkProcessorService {
  }
}

package com.elasticsearch.service.impl {
  class BulkProcessorServiceImpl <<Service>> {
    +insertById() : void
    +updateById() : void
    +deleteById() : void
  }
  class ElasticSearchServiceImpl <<Service>> {
    -logger : Logger
    -transportClient : TransportClient
    +insertById() : void
    +updateById() : void
    +deleteById() : void
  }
  class QueryServiceImpl <<Service>> {
  }
}

package com.elasticsearch.util {
  class EmptyUtils {
    +isEmpty() : boolean
  }
}

' --- Relatii ---
BulkProcessorServiceTest --> App
BulkProcessorServiceTest --> Order
ElasticSearchServiceTest --> App
ElasticSearchServiceTest --> Order
QueryServiceTest --> App
QueryServiceTest --> Es
QueryServiceTest --> Order
App --> ElasticSearchConfig
ElasticSearchConfig --> EmptyUtils
QueryService --> Es
BulkProcessorServiceImpl ..|> BulkProcessorService
BulkProcessorServiceImpl --> BulkProcessorService
ElasticSearchServiceImpl ..|> ElasticSearchService
ElasticSearchServiceImpl --> ElasticSearchService
QueryServiceImpl ..|> QueryService
QueryServiceImpl --> Es
QueryServiceImpl --> QueryService

@enduml