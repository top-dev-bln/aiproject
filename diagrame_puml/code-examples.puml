package app.ses {
  class SESWorker {
    -LOG : Logger
    -iCanContinue : boolean
    -queue : Queue<AmazonEmail>
    -item : AmazonEmail
    -MAX_SLEEP_TIME : int
    -sesClient : AmazonSimpleEmailService
    -id : int
    +run() : void
    +add() : void
    +stopWorker() : void
    +getTime() : String
  }
  class AmazonEmail {
    -to : List<String>
    -cc : List<String>
    -bcc : List<String>
    -from : SESFrom
    -subject : String
    -body : String
    -html : boolean
    -files : List<AmazonAttachment>
    +getTo() : List<String>
    +setTo() : void
    +setTo() : void
    +getCc() : List<String>
    +setCc() : void
    +setCc() : void
    +getBcc() : List<String>
    +setBcc() : void
  }
  enum SESFrom {
    -email : String
    -name : String
    +getEmail() : String
    +getName() : String
  }
  class AmazonAttachment {
    -name : String
    -content : byte[]
    -contentType : String
    +getName() : String
    +setName() : void
    +getContent() : byte[]
    +setContent() : void
    +getContentType() : String
    +setContentType() : void
  }
  class SESProcessor {
    -LOG : Logger
    -iCanContinue : boolean
    -sInstance : SESProcessor
    -workers : SESWorker[]
    -queue : Queue<AmazonEmail>
    -MAX_SLEEP_TIME : int
    -MAX_WORKERS : int
    -current : int
    +run() : void
    +add() : void
    +stopProcessor() : void
    +getTime() : String
  }
}

