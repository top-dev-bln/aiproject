package com.linuxtips.javaweekapi.controller {
  class CursoController <<Controller>> {
    +criarCurso() : Curso
    +listarCursos() : List<Curso>
    +buscarCursoPeloId() : ResponseEntity<Curso>
    +atualizarCursoPeloId() : ResponseEntity<Curso>
    +excluirCursoPeloId() : ResponseEntity<Object>
  }
}

package com.linuxtips.javaweekapi.model {
  class Curso <<Entity>> {
    -id : Long
    -nome : String
    -preco : Double
    -pessoaInstrutora : String
    +getId() : Long
    +setId() : void
    +getNome() : String
    +setNome() : void
    +getPreco() : Double
    +setPreco() : void
    +getPessoaInstrutora() : String
    +setPessoaInstrutora() : void
  }
}

package com.linuxtips.javaweekapi.repository {
  interface CursoRepository <<Repository>> {
  }
}

package com.linuxtips.javaweekapi.service {
  class CursoService <<Service>> {
    -cursoRepository : CursoRepository
    +criarCurso() : Curso
    +listarCursos() : List<Curso>
    +buscarCursoPeloId() : ResponseEntity<Curso>
    +atualizarCursoPeloId() : ResponseEntity<Curso>
    +excluirCursoPeloId() : ResponseEntity<Object>
  }
}

