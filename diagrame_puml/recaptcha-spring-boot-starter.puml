  }
  class SecurityController <<Controller>> {
    +getResponseData() : ResponseData
  }
  class RecaptchaAuthenticationFilter {
    -log : Logger
    -recaptchaValidator : RecaptchaValidator
    -recaptcha : RecaptchaProperties
