    +recaptchaAwareRedirectStrategy() : RecaptchaAwareRedirectStrategy
  }
}

package com.github.mkopylec.recaptcha.security.login {
  class LoginFailuresClearingHandler {
    -failuresManager : LoginFailuresManager
    +onAuthenticationSuccess() : void
  }
  class RecaptchaAwareRedirectStrategy {
    -RECAPTCHA_ERROR_PARAMETER_NAME : String
    -SHOW_RECAPTCHA_QUERY_PARAM : String
    -failuresManager : LoginFailuresManager
    +sendRedirect() : void
    +getAuthenticationException() : AuthenticationException
  }
  class InMemoryLoginFailuresManager {
    -log : Logger
    +addLoginFailure() : void
    +getLoginFailuresCount() : int
    +clearLoginFailures() : void
  }
  class LoginFailuresCountingHandler {
    -failuresManager : LoginFailuresManager
    +onAuthenticationFailure() : void
    +setRedirectStrategy() : void
  }
  class FormLoginConfigurerEnhancer {
    -DEFAULT_USERNAME_PARAMETER : String
    -AUTHENTICATION_PROCESSING_FILTER_FIELD : String
    -authenticationFilter : RecaptchaAuthenticationFilter
    -successHandler : LoginFailuresClearingHandler
    -failureHandler : LoginFailuresCountingHandler
    +addRecaptchaSupport() : FormLoginConfigurer<HttpSecurity>
  }
  class LoginFailuresManager {
    -log : Logger
    -security : Security
    -usernameParameter : String
    +addLoginFailure() : void
    +getLoginFailuresCount() : int
    +clearLoginFailures() : void
    +isRecaptchaRequired() : boolean
    +setUsernameParameter() : void
    +getUsername() : String
  }
}

