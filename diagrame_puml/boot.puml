@startuml

package com.xwolf {
  class BootApplicationTests {
    +contextLoads() : void
  }
  class BootApplication {
    +main() : void
  }
}

package com.xwolf.boot.annotation {
  interface AvoidRepeatableCommit {
  }
}

package com.xwolf.boot.api {
  interface UserBaseController {
  }
  interface ApiBaseController {
  }
}

package com.xwolf.boot.aspect {
  class AvoidRepeatableCommitAspect {
    -redisTemplate : RedisTemplate
    +around() : Object
  }
}

package com.xwolf.boot.config {
  class InterceptorConfig {
    -EXCLUDE_PATH : String[]
    +addInterceptors() : void
  }
  class SwaggerConfig {
    +createRestApi() : Docket
  }
  class DataSourceConfig {
    -log : Logger
    -prop : RelaxedPropertyResolver
    -environment : Environment
    +setEnvironment() : void
    +dataSource() : DataSource
    +filterRegistrationBean() : FilterRegistrationBean
    +servletRegistrationBean() : ServletRegistrationBean
  }
  class FilterConfig {
    -URLS : String[]
    +filterRegistrationBean() : FilterRegistrationBean
  }
  class Constants {
    -DATE_DEFAULT_FORMAT : String
    -DATETIME_DEFAULT_FORMAT : String
    -TIME_DEFAULT_FORMAT : String
    -AVOID_REPEATABLE_TIMEOUT : long
  }
}

package com.xwolf.boot.controller {
  class ApiController <<Controller>> {
    +getUserList() : List<User>
    +postUser() : String
    +getUser() : User
    +putUser() : String
    +deleteUser() : String
  }
  class ErrorController <<Controller>> {
    +error500() : String
    +error404() : String
    +error400() : String
    +error302() : String
  }
  class UserController <<Controller>> {
    -userService : IUserService
    +insert() : String
    +getUserList() : List<User>
  }
}

package com.xwolf.boot.dao {
  interface IUserDao {
  }
}

package com.xwolf.boot.entity {
  class User {
    -uid : int
    -uname : String
    -birth : Date
  }
}

package com.xwolf.boot.interceptor {
  class XSSFilter {
    -filterConfig : FilterConfig
    +init() : void
    +doFilter() : void
    +destroy() : void
  }
  class XSSHttpServletRequestWrapper {
    +getParameterValues() : String[]
    +getParameter() : String
    +getHeader() : String
  }
  class ErrorInterceptor {
    +preHandle() : boolean
    +postHandle() : void
    +afterCompletion() : void
  }
  class CsrfInterceptor {
    -WHITE_URLS : String[]
    -host : String
    +preHandle() : boolean
    +postHandle() : void
    +afterCompletion() : void
  }
}

package com.xwolf.boot.service {
  interface IUserService {
  }
}

package com.xwolf.boot.service.impl {
  class UserServiceImpl <<Service>> {
    -userDao : IUserDao
    +insert() : String
    +getList() : List<User>
  }
}

package com.xwolf.boot.utils {
  class StringUtils {
    +isBlank() : boolean
    +isNotBlank() : boolean
  }
  class IPUtil {
    +getIP() : String
  }
  class UUIDUtil {
    +uuid() : String
  }
}

' --- Relatii ---
InterceptorConfig --> CsrfInterceptor
InterceptorConfig --> ErrorInterceptor
DataSourceConfig --> StringUtils
FilterConfig --> XSSFilter
User --> Constants
IUserDao --> User
ApiController ..|> ApiBaseController
ApiController --> ApiBaseController
ApiController --> User
UserController ..|> UserBaseController
UserController --> AvoidRepeatableCommit
UserController --> UserBaseController
UserController --> User
UserController --> IUserService
UserBaseController --> User
ApiBaseController --> User
AvoidRepeatableCommitAspect --> AvoidRepeatableCommit
AvoidRepeatableCommitAspect --> Constants
AvoidRepeatableCommitAspect --> IPUtil
AvoidRepeatableCommitAspect --> StringUtils
AvoidRepeatableCommitAspect --> UUIDUtil
IUserService --> User
UserServiceImpl ..|> IUserService
UserServiceImpl --> IUserDao
UserServiceImpl --> User
UserServiceImpl --> IUserService
CsrfInterceptor --> StringUtils

@enduml