    -kafkaTemplate : KafkaTemplate
    +setObservationForKafkaTemplate() : void
  }
  class RestClientConfig {
    -inventoryServiceUrl : String
    -observationRegistry : ObservationRegistry
    +inventoryClient() : InventoryClient
  }
}

package com.techie.microservices.order.controller {
  class OrderController <<Controller>> {
    -orderService : OrderService
    +placeOrder() : String
    +fallbackMethod() : CompletableFuture<String>
  }
}

package com.techie.microservices.order.model {
  class Order <<Entity>> {
    -id : Long
    -orderNumber : String
    -skuCode : String
    -price : BigDecimal
    -quantity : Integer
  }
}

package com.techie.microservices.order.repository {
  interface OrderRepository {
  }
}

package com.techie.microservices.order.service {
  class OrderService <<Service>> {
    -orderRepository : OrderRepository
    -inventoryClient : InventoryClient
    +placeOrder() : void
  }
}

