@startuml

package com.techie.microservices.gateway {
  class ApiGatewayApplication {
    +main() : void
  }
}

package com.techie.microservices.gateway.config {
  class SecurityConfig {
    -freeResourceUrls : String[]
    +securityFilterChain() : SecurityFilterChain
  }
}

package com.techie.microservices.gateway.routes {
  class Routes {
    -productServiceUrl : String
    -orderServiceUrl : String
    -inventoryServiceUrl : String
    +productServiceRoute() : RouterFunction<ServerResponse>
    +productServiceSwaggerRoute() : RouterFunction<ServerResponse>
    +orderServiceRoute() : RouterFunction<ServerResponse>
    +orderServiceSwaggerRoute() : RouterFunction<ServerResponse>
    +inventoryServiceRoute() : RouterFunction<ServerResponse>
    +inventoryServiceSwaggerRoute() : RouterFunction<ServerResponse>
    +fallbackRoute() : RouterFunction<ServerResponse>
  }
}

package com.techie.microservices.inventory {
  class InventoryServiceApplication {
    +main() : void
  }
}

package com.techie.microservices.inventory.config {
  class OpenAPIConfig {
    +orderServiceAPI() : OpenAPI
  }
  class ObservabilityConfig {
  }
}

package com.techie.microservices.inventory.controller {
  class InventoryController <<Controller>> {
    -inventoryService : InventoryService
    +isInStock() : boolean
  }
}

package com.techie.microservices.inventory.model {
  class Inventory <<Entity>> {
    -id : Long
    -skuCode : String
    -quantity : Integer
  }
}

package com.techie.microservices.inventory.repository {
  interface InventoryRepository {
  }
}

package com.techie.microservices.inventory.service {
  class InventoryService <<Service>> {
    -inventoryRepository : InventoryRepository
    +isInStock() : boolean
  }
}

package com.techie.microservices.notification {
  class NotificationServiceApplication {
    +main() : void
  }
}

package com.techie.microservices.notification.config {
  class ObservabilityConfig {
    -concurrentKafkaListenerContainerFactory : ConcurrentKafkaListenerContainerFactory
    +setObservationForKafkaTemplate() : void
  }
}

package com.techie.microservices.notification.service {
  class NotificationService <<Service>> {
    -javaMailSender : JavaMailSender
    +listen() : void
  }
}

package com.techie.microservices.order {
  class OrderServiceApplicationTests {
    -mySQLContainer : MySQLContainer
    -port : Integer
  }
