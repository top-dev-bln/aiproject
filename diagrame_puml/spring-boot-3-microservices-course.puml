    +main() : void
  }
  class OrderServiceApplication {
    +main() : void
  }
}

package com.techie.microservices.order.client {
  interface InventoryClient {
  }
}

package com.techie.microservices.order.config {
  class OpenAPIConfig {
    +orderServiceAPI() : OpenAPI
  }
