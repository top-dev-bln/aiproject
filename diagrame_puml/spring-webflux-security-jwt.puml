@startuml

package io.rapha.spring.reactive.security {
  class SecuredRestApplicationTest {
    -context : ApplicationContext
    -rest : WebTestClient
    +messageWhenNotAuthenticated() : void
  }
  class SecuredRestApplication {
    +main() : void
    +userDetailsRepository() : MapReactiveUserDetailsService
    +springSecurityFilterChain() : SecurityWebFilterChain
  }
}

package io.rapha.spring.reactive.security.api {
  class MessageController <<Controller>> {
    +hello() : Flux<FormattedMessage>
    +login() : Flux<FormattedMessage>
    +privateMessage() : Flux<FormattedMessage>
    +privateMessageAdmin() : Flux<FormattedMessage>
    +privateMessageGuest() : Flux<FormattedMessage>
  }
}

package io.rapha.spring.reactive.security.auth.basic {
  class BasicAuthenticationSuccessHandler {
    +onAuthenticationSuccess() : Mono<Void>
  }
}

package io.rapha.spring.reactive.security.auth.bearer {
  class ServerHttpBearerAuthenticationConverter {
    -BEARER : String
    -matchBearerLength : Predicate<String>
    -jwtVerifier : JWTCustomVerifier
    +apply() : Mono<Authentication>
  }
  class BearerTokenReactiveAuthenticationManager {
    +authenticate() : Mono<Authentication>
  }
}

package io.rapha.spring.reactive.security.auth.jwt {
  class JWTTokenService {
    +generateToken() : String
  }
  class JWTSecrets {
    -DEFAULT_SECRET : String
  }
  class JWTCustomVerifier {
    -jwsVerifier : JWSVerifier
    -isNotExpired : Predicate<SignedJWT>
    -validSignature : Predicate<SignedJWT>
    +check() : Mono<SignedJWT>
  }
  class JWTCustomSigner {
    -signer : JWSSigner
    +getSigner() : JWSSigner
  }
  class AuthorizationHeaderPayload {
    +extract() : Mono<String>
  }
  class UsernamePasswordAuthenticationBearer {
    +create() : Mono<Authentication>
  }
}

package io.rapha.spring.reactive.security.domain {
  class FormattedMessage {
    -name : String
    -message : String
    +getMessage() : String
    +setMessage() : void
    +getName() : String
    +setName() : void
  }
}

package io.rapha.spring.reactive.security.service {
  class MessageService {
    +getDefaultMessage() : Flux<FormattedMessage>
    +getCustomMessage() : Flux<FormattedMessage>
  }
}

' --- Relatii ---
SecuredRestApplication --> BasicAuthenticationSuccessHandler
SecuredRestApplication --> BearerTokenReactiveAuthenticationManager
SecuredRestApplication --> ServerHttpBearerAuthenticationConverter
BasicAuthenticationSuccessHandler --> JWTTokenService
ServerHttpBearerAuthenticationConverter --> AuthorizationHeaderPayload
ServerHttpBearerAuthenticationConverter --> UsernamePasswordAuthenticationBearer
ServerHttpBearerAuthenticationConverter --> JWTCustomVerifier
MessageController --> FormattedMessage
MessageController --> MessageService
MessageService --> FormattedMessage

@enduml