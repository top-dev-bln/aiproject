@startuml

package example {
  class SpringModulithTests {
  }
  class LibraryWebSecurityConfiguration {
    +filterChain() : SecurityFilterChain
  }
  class LibraryApplication {
    +main() : void
  }
}

package example.borrow {
  class BorrowJMoleculesTests {
  }
  class CirculationDeskControllerIT {
    -mockMvc : MockMvc
  }
  class CirculationDeskIT {
  }
  class CirculationDeskTest {
  }
}

package example.borrow.application {
  class CirculationDesk <<Service>> {
    -books : BookRepository
    -holds : HoldRepository
    +placeHold() : HoldInformation
    +locate() : Optional<HoldInformation>
    +checkout() : HoldInformation
    +handle() : void
    +handle() : void
    +handle() : void
  }
  class HoldInformation {
    -id : String
    -bookBarcode : String
    -patronId : String
    -dateOfHold : LocalDate
    -dateOfCheckout : LocalDate
    +from() : HoldInformation
  }
}

package example.borrow.domain {
  class Hold <<Entity>> {
    -id : HoldId
    -heldBy : PatronId
    -dateOfHold : LocalDate
    -dateOfCheckout : LocalDate
    -status : HoldStatus
    -version : Long
    +placeHold() : Hold
    +checkout() : Hold
    +then() : Hold
    +isHeldBy() : boolean
    +HoldId() : record
    +PlaceHold() : record
    +Checkout() : record
    +BookCheckedOut() : record
  }
  class Patron {
    -id : PatronId
    -status : Membership
    +of() : Patron
    +deactivate() : void
    +PatronId() : record
  }
  interface BookRepository <<Repository>> {
  }
  class Book <<Entity>> {
    -id : BookId
    -inventoryNumber : Barcode
    -title : String
    -isbn : String
    -status : BookStatus
    -version : Long
    +addBook() : Book
    +markOnHold() : Book
    +markCheckedOut() : Book
    +BookId() : record
    +Barcode() : record
    +of() : Barcode
    +AddBook() : record
  }
  interface HoldRepository {
  }
}

package example.borrow.infrastructure {
  class CirculationDeskController <<Controller>> {
    -circulationDesk : CirculationDesk
  }
}

package example.catalog {
  class CatalogControllerIT {
    -mockMvc : MockMvc
  }
  class CatalogIntegrationTests {
  }
  class CatalogJMoleculesTests {
  }
}

package example.catalog.application {
  class CatalogManagement <<Service>> {
    -catalogRepository : CatalogRepository
    +addToCatalog() : BookDto
    +locate() : Optional<BookDto>
    +fetchBooks() : List<BookDto>
  }
}

package example.catalog.domain {
  class CatalogBook <<Entity>> {
    -id : Long
    -title : String
    -catalogNumber : Barcode
    -isbn : String
    -author : Author
    -version : Long
    +Barcode() : record
    +Author() : record
  }
  interface CatalogRepository {
  }
}

package example.catalog.ui {
  class CatalogController <<Controller>> {
    -books : CatalogManagement
  }
}

package example.useraccount {
  class KeycloakJwtAuthenticationConverter {
    +convert() : AbstractAuthenticationToken
  }
}

package example.useraccount.web {
  interface Authenticated {
  }
  class AuthenticatedUserArgumentResolver {
    -USER_EXPECTED : String
    -USER : ResolvableType
    -OPTIONAL_OF_USER : ResolvableType
    +resolveArgument() : Object
    +supportsParameter() : boolean
    +addArgumentResolvers() : void
  }
}

' --- Relatii ---
CatalogIntegrationTests --> CatalogManagement
CatalogIntegrationTests --> CatalogRepository
CirculationDeskIT --> CirculationDesk
CirculationDeskIT --> Book
CirculationDeskIT --> BookRepository
CirculationDeskIT --> Hold
CirculationDeskIT --> HoldRepository
CirculationDeskTest --> CirculationDesk
CirculationDeskTest --> Book
CirculationDeskTest --> BookRepository
CirculationDeskTest --> Hold
CirculationDeskTest --> HoldRepository
LibraryWebSecurityConfiguration --> KeycloakJwtAuthenticationConverter
CatalogController --> CatalogManagement
CatalogManagement --> CatalogBook
CatalogManagement --> CatalogRepository
CirculationDesk --> Book
CirculationDesk --> BookRepository
CirculationDesk --> Hold
CirculationDesk --> HoldRepository
HoldInformation --> Hold
CirculationDeskController --> CirculationDesk
CirculationDeskController --> HoldInformation
CirculationDeskController --> Book
CirculationDeskController --> Hold
CirculationDeskController --> Authenticated

@enduml