@startuml

package com.octoperf {
  class Application {
    +main() : void
  }
}

package com.octoperf.auth.api {
  interface UserAuthenticationService {
  }
}

package com.octoperf.date.service {
  class JodaDateService {
    -timeZone : DateTimeZone
    -timeZone : DateTimeZone
    +now() : DateTime
  }
  interface DateService {
  }
  class DateServiceConfig {
  }
}

package com.octoperf.security.config {
  class SecurityConfig {
    -PUBLIC_URLS : RequestMatcher
    -PROTECTED_URLS : RequestMatcher
    -provider : TokenAuthenticationProvider
    -auth : AuthenticationManagerBuilder
    -web : WebSecurity
    -http : HttpSecurity
    -filter : TokenAuthenticationFilter
    -successHandler : SimpleUrlAuthenticationSuccessHandler
    -filter : TokenAuthenticationFilter
    -registration : FilterRegistrationBean
    +configure() : void
    +configure() : void
    +configure() : void
  }
  class TokenAuthenticationFilter {
    -BEARER : String
    -requiresAuth : RequestMatcher
    -request : HttpServletRequest
    -response : HttpServletResponse
    -param : String
    -token : String
    -auth : Authentication
    -request : HttpServletRequest
    -response : HttpServletResponse
    -chain : FilterChain
    +attemptAuthentication() : Authentication
    +successfulAuthentication() : void
  }
  class NoRedirectStrategy {
    -request : HttpServletRequest
    -response : HttpServletResponse
    -url : String
    +sendRedirect() : void
  }
  class TokenAuthenticationProvider {
    -d : UserDetails
    -auth : UsernamePasswordAuthenticationToken
    -username : String
    -authentication : UsernamePasswordAuthenticationToken
    -token : Object
    +additionalAuthenticationChecks() : void
    +retrieveUser() : UserDetails
  }
}

package com.octoperf.token.api {
  interface TokenService {
  }
}

package com.octoperf.token.jwt {
  class JWTTokenService <<Service>> {
    -DOT : String
    -COMPRESSION_CODEC : GzipCompressionCodec
    -dates : DateService
    -issuer : String
    -expirationSec : int
    -clockSkewSec : int
    -secret : String
    -expiresInSec : int
    -now : DateTime
    -claims : Claims
    +permanent() : String
    +expiring() : String
    +now() : Date
  }
}

package com.octoperf.user.auth.crud {
  class TokenAuthenticationService <<Service>> {
    -username : String
    -password : String
    -token : String
    -user : User
    +login() : Optional<String>
    +findByToken() : Optional<User>
    +logout() : void
  }
}

package com.octoperf.user.auth.map {
  class UUIDAuthenticationService <<Service>> {
    -username : String
    -password : String
    -uuid : String
    -user : User
    -token : String
    -user : User
    +login() : Optional<String>
    +findByToken() : Optional<User>
    +logout() : void
  }
}

package com.octoperf.user.controller {
  class PublicUsersController <<Controller>> {
    -username : String
    -password : String
    -username : String
    -password : String
  }
  class SecuredUsersController <<Controller>> {
    -user : User
    -user : User
  }
}

package com.octoperf.user.crud.api {
  interface UserCrudService {
  }
}

package com.octoperf.user.crud.in.memory {
  class InMemoryUsers <<Service>> {
    -user : User
    -id : String
    -username : String
    +save() : User
    +find() : Optional<User>
    +findByUsername() : Optional<User>
  }
}

package com.octoperf.user.entity {
  class User {
    -serialVersionUID : long
    -id : String
    -username : String
    -password : String
    +getAuthorities() : Collection<GrantedAuthority>
    +getPassword() : String
    +isAccountNonExpired() : boolean
    +isAccountNonLocked() : boolean
    +isCredentialsNonExpired() : boolean
    +isEnabled() : boolean
  }
}

' --- Relatii ---
PublicUsersController --> UserAuthenticationService
PublicUsersController --> UserCrudService
PublicUsersController --> User
SecuredUsersController --> UserAuthenticationService
SecuredUsersController --> User
UserAuthenticationService --> User
UUIDAuthenticationService ..|> UserAuthenticationService
UUIDAuthenticationService --> UserAuthenticationService
UUIDAuthenticationService --> UserCrudService
UUIDAuthenticationService --> User
TokenAuthenticationProvider --> UserAuthenticationService
JodaDateService ..|> DateService
InMemoryUsers ..|> UserCrudService
InMemoryUsers --> UserCrudService
InMemoryUsers --> User
UserCrudService --> User
TokenAuthenticationService ..|> UserAuthenticationService
TokenAuthenticationService --> UserAuthenticationService
TokenAuthenticationService --> TokenService
TokenAuthenticationService --> UserCrudService
TokenAuthenticationService --> User
JWTTokenService ..|> TokenService
JWTTokenService --> DateService
JWTTokenService --> TokenService

@enduml